<h1>Bin</h1>
<a href="/me/my-course">Back to My course</a>

<form name="submitFull" action="/me/delete-all" method="post">

  <div class="form-check form-switch">
    <input name="delete" class="form-check-input" type="checkbox" id="choseAll">
    <button type="submit" disabled>Delete Permanent</button>


  <table class="table">
    <thead>
      <tr>
        <th scope="col"></th>
        <th scope="col">#</th>
        <th scope="col">Name</th>
        <th scope="col">Description</th>
        <th scope="col">createAt</th>
        <th scope="col" colspan="2"></th>
      </tr>
    </thead>
    <tbody>
      {{#each courseDeletes}}
      <tr>
        <td><input name="courseIds[]" value="{{this._id}}" class="form-check-input chose-one-row" type="checkbox"></td>
        <th scope="row">{{sum @index 1}}</th>
        <td>{{this.name}}</td>
        <td>{{this.description}}</td>
        <td>{{this.createAt}}</td>
        <td><a id="{{ this._id }}" class="restoreButton" href="#">restore</a></td>
        <td>
          <a 
            id="{{this._id}}" 
            class="delete-button" 
            href="#" 
            data-bs-toggle="modal" 
            data-bs-target="#delete-course" 
            data-id="{{this._id}}">delete permanent</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

</form>

<form name="deleteCourse" method="POST" style="display: none;"></form>
<form name="restoreCourse" method="POST" style="display: none;"></form>

<!-- Modal -->
<div class="modal fade" id="delete-course" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Delete Course</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete this course?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-danger" id="confirm-delete">Delete Permanent</button>
      </div>
    </div>
  </div>
</div>

<script>

document.addEventListener('DOMContentLoaded', function () {
  const modal = document.getElementById('delete-course');
  const formDelete = document.forms.namedItem('deleteCourse');
  const deleteButtons = document.querySelectorAll('.delete-button');
  const confirmDeleteBtn = document.getElementById('confirm-delete');
  let courseIdToDelete = null; // Biến để lưu _id của khóa học cần xóa

  // Khi bấm nút "delete" để mở modal
  deleteButtons.forEach(button => {
    button.addEventListener('click', function (e) {
      e.preventDefault(); // Ngăn hành vi mặc định của thẻ <a>
      courseIdToDelete = this.getAttribute('data-id'); // Lấy _id từ data-id
    });
  });

  // Khi modal được hiển thị
  modal.addEventListener('shown.bs.modal', () => {
    // Có thể focus vào nút Delete nếu cần
    confirmDeleteBtn.focus();
  });

  // Khi bấm nút "Delete" trong modal
  confirmDeleteBtn.addEventListener('click', function () {
    if (courseIdToDelete) {
      // Gửi DELETE request lên server
      formDelete.action = `/me/${courseIdToDelete}/permanent?_method=DELETE`;
      formDelete.submit();
      fetch('/me/bin')
    }
  });
});

</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {

    const restoreButtons = document.querySelectorAll('.restoreButton')
    let restoreForm = document.forms.namedItem("restoreCourse")
    restoreButtons.forEach(restoreButton => {
      restoreButton.onclick = function (e) {
        e.preventDefault()
        const courseId = e.target.id
        restoreForm.action = `/me/${courseId}/restore?_method=PATCH`
        restoreForm.submit()
      }
    })
  })
</script>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

function checkSubmit(){
    const choseOneRow = $('.chose-one-row');
    if (choseOneRow.filter(':checked').length > 0) {
      $('button[type="submit"]').attr('disabled', false);
    } else {
      $('button[type="submit"]').attr('disabled', true);
    }
}

$(document).ready(function() {
  const choseAll = $('#choseAll');
  const choseOneRow = $('.chose-one-row');

  choseAll.click(function() {
      choseOneRow.prop('checked', $(this).is(':checked'));
      checkSubmit()
  });

  choseOneRow.click(function() {
    if (choseOneRow.length === choseOneRow.filter(':checked').length) {
      choseAll.prop('checked', true);
    } else {
      choseAll.prop('checked', false);
    }
    checkSubmit()

  });

  $('form[name="submitFull"]').submit(function(e) {
    e.preventDefault(); // Ngăn chặn hành vi mặc định của form
    
    // Đếm số checkbox được chọn
    var checkedCount = choseOneRow.filter(':checked').length;
    
    if (checkedCount > 0) {
      this.action = `/me/delete-all?_method=DELETE`
      this.submit()
    } 
    else {
      alert('Vui lòng chọn ít nhất một khóa học để xóa!');
    }
  });
});

</script>