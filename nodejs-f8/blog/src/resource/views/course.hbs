<h1>Course</h1>

<ul>
{{#each courses}}
    <a href="/course/{{ this.slug }}">
        <h2>{{ this.name }}</h2>
    </a>
    <p>{{ this.description }}</p>
    <p>{{this.createAt}}</p>
    <a href="/course/{{ this.slug }}">
        <button>{{this.register}}</button>
    </a>

{{/each}}
</ul>
